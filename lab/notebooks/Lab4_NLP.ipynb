        "        )\n",
        "\n",
        "    cyberlab_df = pd.DataFrame({\n",
        "        'session': fallback_source['session'].astype(str).tolist(),\n",
        "        'date': pd.date_range(start='2019-05-01', periods=len(fallback_source), freq='H'),\n",
