        "timestamp_candidates = ['timestamps_statements', 'parsed_timestamp', 'date', 'timestamp', 'datetime', 'time']\n",
        "timestamp_col = next((col for col in timestamp_candidates if col in cyberlab_df.columns), None)\n",
