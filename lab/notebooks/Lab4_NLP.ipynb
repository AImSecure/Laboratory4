        "NAKED_BERT_LR = 5e-5\n",
        "NAKED_BERT_EPOCHS = 40\n",
        "\n",
        "naked_bert_optimizer = AdamW(bert_naked_model.parameters(), lr=NAKED_BERT_LR)\n",
