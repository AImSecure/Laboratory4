      "cell_type": "code",
      "execution_count": 58,
      "id": "6bff6605",
      "metadata": {
        "id": "6bff6605"
      },
      "outputs": [],
      "source": [
        "# --- Helper function for ECDF ---\n",
        "def get_ecdf(list_numbers):\n",
        "    \"\"\"Calculate Empirical Cumulative Distribution Function.\"\"\"\n",
        "    counter = Counter(list_numbers)\n",
        "    values = sorted(counter.keys())\n",
        "    counts = [counter[value] for value in values]\n",
        "    total = sum(counts)\n",
        "    cumulative_probs = np.cumsum(counts) / total\n",
        "    return values, cumulative_probs"
      ]
    },
